DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True

# Pilot deployment: operator provisioning only. Enable self-service deliberately at general availability.
MADAAR_PUBLIC_REGISTRATION_ENABLED=False
MADAAR_PUBLIC_WORKSPACE_CREATION_ENABLED=False

DB_NAME=school_assessment
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Three interruptions trigger automatic submission; duplicate/correlated signals within five seconds count once.
EXAM_INTEGRITY_INTERRUPTION_LIMIT=3
EXAM_INTEGRITY_DEDUPE_SECONDS=5
