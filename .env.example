DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True

# Pilot deployment: operator provisioning only. Enable self-service deliberately at general availability.
MADAAR_PUBLIC_REGISTRATION_ENABLED=False
MADAAR_PUBLIC_WORKSPACE_CREATION_ENABLED=False

DB_NAME=school_assessment
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Production: use persistent private storage, e.g. /data/private-question-media.
QUESTION_PRIVATE_ROOT=

# Three interruptions trigger automatic submission; duplicate/correlated signals within five seconds count once.
EXAM_INTEGRITY_INTERRUPTION_LIMIT=3
EXAM_INTEGRITY_DEDUPE_SECONDS=5
DJANGO_ALLOWED_HOSTS=

# Explicit frontend origins, comma-separated; no paths or wildcards.
# Production example: https://madaar.pages.dev
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=
# Cross-site HTTPS production cookies. Local development keeps Django defaults.
DJANGO_SESSION_COOKIE_SAMESITE=None
DJANGO_CSRF_COOKIE_SAMESITE=None
DJANGO_QUICK_EXAM_COOKIE_SAMESITE=None
